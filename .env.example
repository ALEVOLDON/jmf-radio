# ========================================================
# 🎧 JMF RADIO - ENVIRONMENT CONFIGURATION
# ========================================================

# HTTP Server Port
PORT=3000

# Absolute path to your local music directory
# Windows Example: D:\Soundcloud or C:\Users\YourName\Music
# Linux/macOS Example: /var/music or ./music
MUSIC_DIR=D:\Soundcloud

# Optional: Crossfade duration in seconds for DJ mode (Default: 8)
DJ_CROSSFADE_SECONDS=8

# Optional: Crossfade duration in seconds for Radio mode (Default: 3)
RADIO_CROSSFADE_SECONDS=3
